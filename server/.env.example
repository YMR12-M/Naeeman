# ═══════════════════════════════════════════════════════════════
#  نعيمًا — إعدادات السيرفر
#  انسخ هذا الملف إلى `.env` ثم عدّل القيم:   cp .env.example .env
#  كل متغيّر موثّق هنا. أي إعداد ناقص أو خطير في الإنتاج بيوقّف السيرفر
#  عند الإقلاع برسالة واضحة (config/env.js).
# ═══════════════════════════════════════════════════════════════

NODE_ENV=development
PORT=4030
API_PREFIX=/api/v1

# ── العناوين ────────────────────────────────────────────────────
# النطاقات المسموح لها تكلّم الـ API (مفصولة بفاصلة).
# لوحة المحل 5200 · تطبيق الزبون 5201 · Electron: app://naeeman · Capacitor: capacitor://localhost,http://localhost
CLIENT_ORIGIN=http://localhost:5200,http://localhost:5201
# عنوان لوحة المحل كما يراه الناس (بيدخل في روابط البريد)
APP_URL=http://localhost:5200
# عنوان تطبيق الزبون (بيدخل في الـ QR وروابط الإشعارات)
CUSTOMER_APP_URL=http://localhost:5201
# العنوان العام للـ API (مطلوب في الإنتاج)
API_PUBLIC_URL=http://localhost:4030

# ── قاعدة البيانات (MySQL 8+) ───────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=naeeman
# قاعدة الاختبارات لازم تنتهي بـ _test — الاختبارات بتمسح بياناتها
DB_NAME_TEST=naeeman_test
DB_CONNECTION_LIMIT=10
DB_SSL=false

# ── الجلسات والتوكنات ───────────────────────────────────────────
# ولّد كل سرّ بأمر مستقل:   openssl rand -base64 48   (32 حرفًا على الأقل في الإنتاج)
JWT_ACCESS_SECRET=dev-only-access-secret-not-for-production
JWT_ACCESS_TTL=15m
# مدّة التجديد للمتصفّح، وللتطبيقات (موبايل/ديسكتوب)
JWT_REFRESH_TTL=30d
JWT_REFRESH_TTL_APP=90d
BCRYPT_ROUNDS=12
# بعد كم محاولة دخول فاشلة يتقفل الحساب، ولمدّة كم دقيقة
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15

# كوكي التجديد (للمتصفّح). في الإنتاج: COOKIE_SECURE=true
COOKIE_SECURE=false
# Lax لو الواجهة والـ API على نفس الموقع. None لو على نطاقين مختلفين تمامًا (يتطلّب COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ── العلامة ─────────────────────────────────────────────────────
BRAND_NAME=نعيمًا

# ── البريد (SMTP) ───────────────────────────────────────────────
# لو SMTP_HOST فاضي في التطوير: الرسائل بتتطبع في اللوج بدل ما تتبعت.
# في الإنتاج لازم SMTP أو MAIL_DISABLED=true صراحةً.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=نعيمًا <no-reply@example.com>
MAIL_DISABLED=false

# ── إشعارات الزباين (Web Push) ──────────────────────────────────
# ولّدها بـ:   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── التشغيل ─────────────────────────────────────────────────────
# المهام الخلفية: مهل الطابور، وإرسال الإشعارات
JOBS_ENABLED=true

# ── المحل هو السيرفر (المرحلة التانية) ───────────────────────────
# السيرفر على كمبيوتر المحل، والتلفزيون والكشك وتابلت الكرسي على واي فاي المحل.
# برنامج الديسكتوب بيضبط كل ده لوحده — بتحتاجه بس لو بتشغّل السيرفر بنفسك.
# HUB_MODE=true بيسمح بـ http عادي (من غير شهادة) وكوكي من غير Secure وعناوين
# محلية حتى مع NODE_ENV=production، وبيشغّل النسخ الاحتياطية الدورية.
HUB_MODE=false
# 0.0.0.0 = كل الشبكة (التابلت والتلفزيون)، 127.0.0.1 = الكمبيوتر ده بس
HOST=0.0.0.0
# السيرفر بيقدّم الواجهتين بنفسه (من غير nginx): لوحة المحل وشاشات الأجهزة (STATIC_DIR)
# على PORT، وتطبيق الزبون (CUSTOMER_STATIC_DIR) على CUSTOMER_PORT. فاضيين = مش بيقدّم.
STATIC_DIR=
CUSTOMER_STATIC_DIR=
CUSTOMER_PORT=
# صور القصّات (مش مكان عام: بتتقري بتوكن بس). اعملها على قرص بيتعمل له نسخ.
UPLOADS_DIR=uploads

# ── النسخ الاحتياطية ────────────────────────────────────────────
# نسخة كاملة للقاعدة (JSON مضغوط) كل BACKUP_EVERY_HOURS وبعد كل تقفيل يوم.
# الافتراضي شغّال في HUB_MODE ومقفول برّاه. npm run db:backup / db:restore
BACKUP_ENABLED=false
BACKUP_DIR=backups
BACKUP_KEEP=30
BACKUP_EVERY_HOURS=6
# فولدر Google Drive أو OneDrive على الجهاز: النسخ والصور بتتنسخ له كمان
# فتطلع على السحابة من غير أي مفاتيح.
BACKUP_COPY_DIR=

# ── أوّل تشغيل (db:bootstrap) ───────────────────────────────────
# تُقرأ مرّة واحدة لإنشاء المحل وحساب المالك الأول، ثم احذف ADMIN_PASSWORD من الملف.
SHOP_NAME=
# اسم المحل في الرابط العام (حروف إنجليزي صغيرة وأرقام وشرطة). لو فاضي بيتولّد.
SHOP_SLUG=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
