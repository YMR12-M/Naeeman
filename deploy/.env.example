# ═══════════════════════════════════════════════════════════════
#  إعدادات docker compose — انسخه لجذر الريبو باسم .env وعدّله
#  الشرح الكامل لكل متغيّر في server/.env.example
# ═══════════════════════════════════════════════════════════════
NODE_ENV=production

# ── قاعدة البيانات (الحاوية db) ──
DB_NAME=naeeman
DB_USER=naeeman
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ── العناوين كما يشوفها الناس (بعد الـ HTTPS) ──
APP_URL=https://panel.example.com
CUSTOMER_APP_URL=https://app.example.com
API_PUBLIC_URL=https://panel.example.com
CLIENT_ORIGIN=https://panel.example.com,https://app.example.com
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ── الأسرار: كل واحد بأمر لوحده  openssl rand -base64 48 ──
JWT_ACCESS_SECRET=

# ── البريد: SMTP أو MAIL_DISABLED=true ──
MAIL_DISABLED=true

# ── إشعارات الزباين:  npx web-push generate-vapid-keys ──
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── أوّل تشغيل بس (المحل والمالك). احذف ADMIN_PASSWORD بعد أوّل دخول ──
SHOP_NAME=
SHOP_SLUG=
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD=
